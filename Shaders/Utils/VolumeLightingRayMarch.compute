#pragma kernel VolumeLightingRayMarch

#pragma multi_compile _ _MAIN_LIGHT_SHADOWS _MAIN_LIGHT_SHADOWS_CASCADE
#pragma multi_compile _ _SHADOWS_SOFT _SHADOWS_SOFT_LOW _SHADOWS_SOFT_MEDIUM _SHADOWS_SOFT_HIGH

#include "Packages/roxamirpcore/Shaders/Core/Common.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"
#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/DeclareDepthTexture.hlsl"

RWTexture2D<float> _VolumeLightingTexture;

float4 _texelSize;
float4 _volumeLightingParams;
#define _stepSize _volumeLightingParams.x
#define _maxStep _volumeLightingParams.y
#define _maxRayLength _volumeLightingParams.z
#define _randomStrength _volumeLightingParams.w

// Generate random value between -1 and 1
float Random(uint2 id)
{
    return Hash21(id) * 2.0 - 1.0;
}

float SampleShadow(float3 positionWS)
{
    float4 shadowCoord = TransformWorldToShadowCoord(positionWS);
    return MainLightRealtimeShadow(shadowCoord);
}

[numthreads(8,8,1)]
void VolumeLightingRayMarch (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_texelSize.x || id.y >= (uint)_texelSize.y)
    {
        return;
    }
    float2 screenSpaceUV = id.xy * _texelSize.zw;
    
    float depth = _CameraDepthTexture.SampleLevel(sampler_CameraDepthTexture, screenSpaceUV, 1).x;

    bool isSkybox = false;
    GetReverseDepthWithSkybox(depth, isSkybox);
    if (isSkybox)
    {
        _VolumeLightingTexture[id.xy] = 1;
        return;
    }
    
    float3 positionWS = CalculateDepthToPositionWS(depth, screenSpaceUV);
    float3 cameraWS = _WorldSpaceCameraPos.xyz;
    float3 rayVec = positionWS - cameraWS;
    
    float3 rayDir = normalize(rayVec);
    float3 rayStart = cameraWS;
    float rayMaxLength = min(length(positionWS - cameraWS), _maxRayLength);
    float volumeLighting = 0;
    float rayLength = 0;
    
    UNITY_LOOP
    for(int j = 0 ; j < _maxStep ; j++)
    {
        rayLength += _stepSize * j;
        if(rayLength > rayMaxLength)
        {
            break;
        }
        
        float3 rayPositionWS = rayStart + rayDir * rayLength;
        
        // Add random jittering in three directions
        if (_randomStrength > 0)
        {
            // Generate independent random offsets for X, Y, Z axes
            float3 randomOffset = float3(
                Random(id.xy + uint2(j, 0)),
                Random(id.xy + uint2(0, j)),
                Random(id.xy + uint2(j, j))
            ) * _randomStrength * _stepSize;
            
            rayPositionWS += randomOffset;
        }

        volumeLighting += SampleShadow(rayPositionWS);
    }
    volumeLighting /= _maxStep;
    
    _VolumeLightingTexture[id.xy] = volumeLighting;
}
